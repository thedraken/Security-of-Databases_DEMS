    "roles": [
    {
      "name": "project_admin",
      "description": "Full project graph access",
      "permissions": [
        {
          "target": "entire_graph",
          "operations": ["READ", "WRITE", "DELETE"]
        },
        {
          "target": "gremlin_target",
          "operations": ["EXECUTE"]
        }
      ]
    },
    {
      "name": "contributor",
      "description": "Read and write, but not remove existing data",
      "permissions": [
        {
          "target": "entire_graph",
          "operations": ["READ", "WRITE"]
        },
        {
          "target": "gremlin_target",
          "operations": ["EXECUTE"]
        }
      ]
    },
    {
      "name": "session_user",
      "description": "Only access to session-related data",
      "permissions": [
        {
          "target": "service_graph",
          "operations": ["READ"]
        },
        {
          "target": "service_schema",
          "operations": ["READ"]
        },
        {
          "target": "gremlin_target",
          "operations": ["EXECUTE"]
        },
        {
            "target": "sessions",
            "operations": ["WRITE"]
        }
      ]
    },
    {
      "name": "viewer",
      "description": "Can only read",
      "permissions": [
        {
          "target": "entire_graph",
          "operations": ["READ"]
        },
        {
          "target": "gremlin_target",
          "operations": ["EXECUTE"]
        }
      ]
    }
    ],
    "users": [
        {
            "name": "project_admin_test",
            "role": "project_admin",
